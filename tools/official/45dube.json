{"meta":{"archived":false,"title":"Come unto Christ","canonicalUrl":"/general-conference/2026/10/45dube?lang=eng","contentType":"text/html","audio":[{"mediaUrl":"https://assets.churchofjesuschrist.org/640gi616peqaiao6qf1pta27fmp9zt2alsr811cv-128k-en.mp3","variant":"audio"}],"pageAttributes":{"data-asset-id":"76c8c46fcdd14c68abc21f5af8cf09a8","data-aid":"173868609","data-aid-version":"1","data-content-type":"general-conference-talk","data-uri":"/general-conference/2026/10/45dube","itemscope":"","itemtype":"http://schema.org/Article","lang":"eng","data-bcp47-lang":"en","data-orig-id":"76c8c46fcdd14c68abc21f5af8cf09a8","data-ai-chatbot-enabled":"false","xmlns:xsi":"http://www.w3.org/2001/XMLSchema-instance"},"ogTagImageUrl":"https://www.churchofjesuschrist.org/imgs/7u7m4s790eo2gd2wfv8xwrsimoampzf77dz90fyq/full/%21192%2C/0/default","scopedClassName":"global-template-mobile_lesson","structuredData":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"datePublished\":\"2026-10-04T00:00:00.000Z\",\"mainEntity\":{\"@type\":\"Article\",\"author\":{\"@type\":\"Person\",\"name\":\"Edward Dube\",\"url\":\"/church/leader/edward-dube\"}}}","hasChat":false},"content":{"head":{"page-meta-social":{"pageMeta":{"title":"Come unto Christ","description":"Elder Dube teaches that we can invite people to come unto Christ and do their best so that He can perfect them through His grace."},"pageSocial":{"title":"Come unto Christ","description":"Elder Dube teaches that we can invite people to come unto Christ and do their best so that He can perfect them through His grace."}},"links":[{"type":"array","rel":"stylesheet","orig-type":"text/css","href":"https://ips-cdn-edge.churchofjesuschrist.org/styles/css/style_global-template-mobile_lesson_scoped.css"}],"scripts":[]},"body":"<header>\n\n<video preload=\"none\" controls=\"controls\" poster=\"https://www.churchofjesuschrist.org/imgs/7u7m4s790eo2gd2wfv8xwrsimoampzf77dz90fyq/full/%21768%2C/0/default\" thumbnail=\"https://www.churchofjesuschrist.org/imgs/7u7m4s790eo2gd2wfv8xwrsimoampzf77dz90fyq/full/%21192%2C/0/default\" data-video-title=\"Edward Dube\" data-video-description=\"A talk given by Edward Dube during the Sunday morning session of the October 2026 general conference.\" data-video-id=\"6406215353112\" data-duration=\"540740\" data-assetId=\"7izhd9jqtc5hli6guxs7jsht19uh5ejytztqwyp2\" data-ref-id=\"7izhd9jqtc5hli6guxs7jsht19uh5ejytztqwyp2\" data-duration-string=\"9:00\" id=\"video2\"><source src=\"https://mediasrv.churchofjesuschrist.org/vod/stream/1241706627001/6406215353112.m3u8\" type=\"application/vnd.apple.mpegurl\" data-width=\"1920\" data-height=\"1080\" data-file-size=\"178165552\"/><source src=\"https://assets.churchofjesuschrist.org/7izhd9jqtc5hli6guxs7jsht19uh5ejytztqwyp2-360p-en.mp4\" type=\"video/mp4\" data-width=\"640\" data-height=\"360\" data-file-size=\"40308442\"/><source src=\"https://assets.churchofjesuschrist.org/7izhd9jqtc5hli6guxs7jsht19uh5ejytztqwyp2-720p-en.mp4\" type=\"video/mp4\" data-width=\"1280\" data-height=\"720\" data-file-size=\"73538936\"/><source src=\"https://assets.churchofjesuschrist.org/7izhd9jqtc5hli6guxs7jsht19uh5ejytztqwyp2-1080p-en.mp4\" type=\"video/mp4\" data-width=\"1920\" data-height=\"1080\" data-file-size=\"178165552\"/></video><h1 data-aid=\"173868614\" id=\"p_tPrSi\">Come unto Christ</h1>\n<div class=\"byline\">\n<p class=\"author-name\" data-aid=\"173868619\" id=\"p_pbDGu\">By Elder Edward Dube</p>\n<p class=\"author-role\" data-aid=\"173868624\" id=\"p_gH0cB\">Of the Presidency of the Seventy</p>\n</div>\n<p class=\"kicker\" data-aid=\"173868629\" id=\"p_pRaNL\">We do not need to perfect ourselves to come to Christ. We come to Christ to be perfected.</p>\n</header>\n<div class=\"body-block\">\n<p data-aid=\"173868637\" id=\"p_ocN6I\">Thirty-nine years ago, President Dallin H. Oaks taught me about the character of Jesus Christ in a way I will never forget.</p>\n<p data-aid=\"173868644\" id=\"p_svmOG\">In 1987, I was a young missionary with only two years in the Church. At the mission office, a sign on the gate read, “Trespassers will be prosecuted.”</p>\n<p data-aid=\"173868652\" id=\"p_fOx72\">President Oaks asked that it be removed to avoid any impression of exclusion. Rather, we invite all to come unto Christ through faith in Him and His Atonement. In that moment, I gained the desire to love others as the Savior does. I love Him. I know He lives. He suffered for me in Gethsemane; “his sweat was as it were great drops of blood.”<a class=\"note-ref\" href=\"#note1\"><sup class=\"marker\" data-value=\"1\"></sup></a> He suffered for me on the cross at Golgotha. I cannot comprehend that suffering, but I testify of His divinity.</p>\n<img alt=\"Jesus Christ in Gethsemane.\" id=\"img_oSA24\" src=\"https://www.churchofjesuschrist.org/imgs/d8db81275b2025a69a32cfa8f74ec9b7c15e913f/full/%21500%2C/0/default\" data-assetId=\"d8db81275b2025a69a32cfa8f74ec9b7c15e913f\" srcset=\"https://www.churchofjesuschrist.org/imgs/d8db81275b2025a69a32cfa8f74ec9b7c15e913f/full/%2160%2C/0/default 60w,https://www.churchofjesuschrist.org/imgs/d8db81275b2025a69a32cfa8f74ec9b7c15e913f/full/%21100%2C/0/default 100w,https://www.churchofjesuschrist.org/imgs/d8db81275b2025a69a32cfa8f74ec9b7c15e913f/full/%21200%2C/0/default 200w,https://www.churchofjesuschrist.org/imgs/d8db81275b2025a69a32cfa8f74ec9b7c15e913f/full/%21250%2C/0/default 250w,https://www.churchofjesuschrist.org/imgs/d8db81275b2025a69a32cfa8f74ec9b7c15e913f/full/%21320%2C/0/default 320w,https://www.churchofjesuschrist.org/imgs/d8db81275b2025a69a32cfa8f74ec9b7c15e913f/full/%21500%2C/0/default 500w,https://www.churchofjesuschrist.org/imgs/d8db81275b2025a69a32cfa8f74ec9b7c15e913f/full/%21640%2C/0/default 640w\" data-img-id=\"d8db81275b2025a69a32cfa8f74ec9b7c15e913f\" data-missing-asset=\"false\" data-width=\"500\" data-height=\"250\" data-aspect-ratio=\"2.0\" data-public-title=\"Christ in Gethsemane\" data-public-description=\"Jesus Christ depicted kneeling at the base of a tree in the Garden of Gethsemane during the Atonement. Christ has His hands clasped as He prays.\"/>\n<p data-aid=\"173868662\" id=\"p_wKUrL\">President Oaks taught, “Jesus Christ did all of this because He loves all of the children of God.”<a class=\"note-ref\" href=\"#note2\"><sup class=\"marker\" data-value=\"2\"></sup></a></p>\n<p data-aid=\"173868670\" id=\"p_mQRML\">His suffering and atoning sacrifice show us how completely devoted He is to all of us. He invites us to come unto Him. Consider Moroni’s invitation: “Yea, come unto Christ, and be perfected in him, … deny yourselves of all ungodliness.”<a class=\"note-ref\" href=\"#note3\"><sup class=\"marker\" data-value=\"3\"></sup></a></p>\n<p data-aid=\"173868682\" id=\"p_vGRMx\">Three key truths to note:</p>\n<ol class=\"decimal\" start=\"1\">\n<li data-marker=\"1.\">\n<p data-aid=\"173868690\" id=\"p_nL0dM\"><strong>Come:</strong> It’s an action. We choose to move from our current place to a better place.</p>\n</li>\n<li data-marker=\"2.\">\n<p data-aid=\"173868698\" id=\"p_tDeXN\"><strong>Deny yourselves:</strong> Surrender. Let go of the things that are holding us back.</p>\n</li>\n<li data-marker=\"3.\">\n<p data-aid=\"173868706\" id=\"p_ll2X5\"><strong>Be perfected in Him:</strong> Come as we are with a willing heart. He will give us a new heart.<a class=\"note-ref\" href=\"#note4\"><sup class=\"marker\" data-value=\"4\"></sup></a></p>\n</li>\n</ol>\n<p data-aid=\"173868714\" id=\"p_otdmK\">We do not need to perfect ourselves to come to Christ. We come to Christ to be perfected.</p>\n<p data-aid=\"173868725\" id=\"p_cZaGJ\">President Russell M. Nelson taught: “Perfection is pending. It can come in full only after the Resurrection and only through the Lord. It awaits all who love Him and keep His commandments.”<a class=\"note-ref\" href=\"#note5\"><sup class=\"marker\" data-value=\"5\"></sup></a></p>\n<p data-aid=\"173868732\" id=\"p_esATU\">Last June on the way to the airport, President Brian Pace from the Wilmington North Carolina Stake asked, “Can we make one more ministering visit?”</p>\n<p data-aid=\"173868740\" id=\"p_amSQb\">“I have a flight to catch,” I thought. But he was already talking. “Brother Randall Child is a good man. He is trying very hard to stop smoking.”</p>\n<p data-aid=\"173868745\" id=\"p_ppO9R\">There I am praying and panicking at the same time—I have never smoked a day in my life. What do I say? “Heavenly Father,” I pleaded, “please put words in my mouth.”</p>\n<p data-aid=\"173868750\" id=\"p_bb4d4\">At the Childs’ home, following greetings and introductions, I empathized with his efforts to quit smoking. Then I asked, “Brother Child, how much do you love your wife, Laurin?”</p>\n<p data-aid=\"173868755\" id=\"p_oZ4I2\">His expression changed. “With all my heart.”</p>\n<p data-aid=\"173868760\" id=\"p_cFr20\">“Would you give up anything for her?” I asked.</p>\n<p data-aid=\"173868767\" id=\"p_z0Htw\">My heart pounding, I extended the invitation: “Will you and Laurin go find a quiet room and choose a date to be sealed in the house of the Lord?”</p>\n<p data-aid=\"173868773\" id=\"p_uxNAJ\">A few minutes later they came back with an answer: “August 5.”</p>\n<p data-aid=\"173868779\" id=\"p_mo9XT\">We left after kneeling in prayer. And just two months later they were sealed in the temple.</p>\n<img alt=\"Randall and Laurin Child at the temple.\" id=\"img_xcZ3Q\" src=\"https://www.churchofjesuschrist.org/imgs/9k48efh6gt6wvsy4rw4de7q5e6pd1ml041w8b4db/full/%21500%2C/0/default\" data-assetId=\"9k48efh6gt6wvsy4rw4de7q5e6pd1ml041w8b4db\" srcset=\"https://www.churchofjesuschrist.org/imgs/9k48efh6gt6wvsy4rw4de7q5e6pd1ml041w8b4db/full/%2160%2C/0/default 60w,https://www.churchofjesuschrist.org/imgs/9k48efh6gt6wvsy4rw4de7q5e6pd1ml041w8b4db/full/%21100%2C/0/default 100w,https://www.churchofjesuschrist.org/imgs/9k48efh6gt6wvsy4rw4de7q5e6pd1ml041w8b4db/full/%21200%2C/0/default 200w,https://www.churchofjesuschrist.org/imgs/9k48efh6gt6wvsy4rw4de7q5e6pd1ml041w8b4db/full/%21250%2C/0/default 250w,https://www.churchofjesuschrist.org/imgs/9k48efh6gt6wvsy4rw4de7q5e6pd1ml041w8b4db/full/%21320%2C/0/default 320w,https://www.churchofjesuschrist.org/imgs/9k48efh6gt6wvsy4rw4de7q5e6pd1ml041w8b4db/full/%21500%2C/0/default 500w,https://www.churchofjesuschrist.org/imgs/9k48efh6gt6wvsy4rw4de7q5e6pd1ml041w8b4db/full/%21640%2C/0/default 640w\" data-img-id=\"9k48efh6gt6wvsy4rw4de7q5e6pd1ml041w8b4db\" data-missing-asset=\"false\" data-width=\"500\" data-height=\"758\" data-aspect-ratio=\"0.6596306068601583\" data-public-title=\"Randall and Laurin Child stand together outside of the temple.\" data-public-description=\"Randall and Laurin Child stand together outside of the temple.\"/>\n<p data-aid=\"173868784\" id=\"p_x7sSt\">Sister Child shared this with me later: “I stayed awake all night because I couldn’t bear watching Randall suffer—wanting to be perfect in every way possible. So all night I cried and pleaded with the Lord to help him. In the early hours of the morning, the answer came very clear: ‘Randall doesn’t need to be perfect. He needs to do the very best he can.’”</p>\n<p data-aid=\"173868790\" id=\"p_uXKaU\">Randall added: “I had trust in the Lord. But when I heard Laurin praying for me—saying all I needed to do was the best I could—I knew then that she was an answer to my prayers.”</p>\n<p data-aid=\"173868796\" id=\"p_vouiF\">Brothers and sisters, let us consider Laurin’s answer to her prayer. The Lord said, “He needs to do the very best he can.” Randall didn’t perfect himself to come to Christ. He came to Christ—with prayer, with trust, and with a willing heart. The Savior, through His grace, helped him to let go of what was holding him back.</p>\n<p data-aid=\"173868801\" id=\"p_k59YA\">And that is why President Oaks had the sign on the gate taken down: “Trespassers will be prosecuted.” The adversary wants to hang that sign on the gate of our heart. Addiction, doubt, pride, pain, grief, guilt, materialism—or whatever is holding us back—he tells us this makes us unworthy to come unto Christ.</p>\n<p data-aid=\"173868806\" id=\"p_dzppg\">But Moroni taught it. Laurin heard it. Randall lived it. You too can live it. If you will “deny not his power, then are ye sanctified in Christ by the grace of God, through the shedding of the blood of Christ.”<a class=\"note-ref\" href=\"#note6\"><sup class=\"marker\" data-value=\"6\"></sup></a></p>\n<p data-aid=\"173868811\" id=\"p_pRacA\">One of our former missionaries wrote me recently and said, “As for my faith, my testimony is not as certain as it once was.”</p>\n<p data-aid=\"173868814\" id=\"p_x2pcP\">To him, and to all who feel that same ache, I invite you, please come unto Christ and embrace His promise, “that [His] joy might remain in you, and that your joy might be full.”<a class=\"note-ref\" href=\"#note7\"><sup class=\"marker\" data-value=\"7\"></sup></a></p>\n<p data-aid=\"173868817\" id=\"p_dreg7\">My humble invitation to us all: Will you find one person and invite him or her to come unto Christ by exercising faith to follow His teachings, or invite a friend to meet with the missionaries?</p>\n<p data-aid=\"173868820\" id=\"p_iaalj\">As you lose yourself in helping him or her come unto Christ, you will find solutions to your current problems. Our Savior has promised, “For whosever will save his life shall lose it: and whosever will lose his life for my sake shall find it.”<a class=\"note-ref\" href=\"#note8\"><sup class=\"marker\" data-value=\"8\"></sup></a> I testify of His divinity in the name of Jesus Christ, amen.</p>\n</div>\n<footer class=\"notes\">\n<p class=\"title\" data-aid=\"173868823\" id=\"p_mFUka\">Notes</p>\n<ol class=\"decimal\" data-type=\"marker\" start=\"1\">\n<li data-marker=\"1.\" id=\"note1\" data-full-marker=\"1.\">\n<p data-aid=\"173868826\" id=\"p_rMtX7\"><a class=\"scripture-ref\" href=\"/study/scriptures/nt/luke/22?lang=eng&amp;id=p44#p44\">Luke 22:44</a>.</p>\n</li>\n<li data-marker=\"2.\" id=\"note2\" data-full-marker=\"2.\">\n<p data-aid=\"173868829\" id=\"p_f0fhL\">Dallin H. Oaks, “<a class=\"cross-ref\" href=\"/study/general-conference/2021/04/35oaks?lang=eng&amp;id=p32#p32\">What Has Our Savior Done for Us?</a>” <cite>Liahona</cite>, May 2021, 77.</p>\n</li>\n<li data-marker=\"3.\" id=\"note3\" data-full-marker=\"3.\">\n<p data-aid=\"173868832\" id=\"p_yETOD\"><a class=\"scripture-ref\" href=\"/study/scriptures/bofm/moro/10?lang=eng&amp;id=p32#p32\">Moroni 10:32</a>.</p>\n</li>\n<li data-marker=\"4.\" id=\"note4\" data-full-marker=\"4.\">\n<p data-aid=\"173868835\" id=\"p_iTJ7R\">See <a class=\"scripture-ref\" href=\"/study/scriptures/ot/ezek/36?lang=eng&amp;id=p26#p26\">Ezekiel 36:26</a>.</p>\n</li>\n<li data-marker=\"5.\" id=\"note5\" data-full-marker=\"5.\">\n<p data-aid=\"173868838\" id=\"p_aGsBb\">Russell M. Nelson, “<a class=\"cross-ref\" href=\"/study/general-conference/1995/10/perfection-pending?lang=eng&amp;id=p40#p40\">Perfection Pending</a>,” <cite>Ensign</cite>, Nov. 1995, 88.</p>\n</li>\n<li data-marker=\"6.\" id=\"note6\" data-full-marker=\"6.\">\n<p data-aid=\"173868843\" id=\"p_a7F1G\"><a class=\"scripture-ref\" href=\"/study/scriptures/bofm/moro/10?lang=eng&amp;id=p33#p33\">Moroni 10:33</a>.</p>\n</li>\n<li data-marker=\"7.\" id=\"note7\" data-full-marker=\"7.\">\n<p data-aid=\"173868847\" id=\"p_eibtt\"><a class=\"scripture-ref\" href=\"/study/scriptures/nt/john/15?lang=eng&amp;id=p11#p11\">John 15:11</a>.</p>\n</li>\n<li data-marker=\"8.\" id=\"note8\" data-full-marker=\"8.\">\n<p data-aid=\"173868848\" id=\"p_zEiqz\"><a class=\"scripture-ref\" href=\"/study/scriptures/nt/matt/16?lang=eng&amp;id=p25#p25\">Matthew 16:25</a>.</p>\n</li>\n</ol>\n</footer>","footnotes":{"note1":{"id":"note1","marker":"1.","pid":"173868652","context":"","text":"<p data-aid=\"173868826\" id=\"p_rMtX7\"><a class=\"scripture-ref\" href=\"/study/scriptures/nt/luke/22?lang=eng&amp;id=p44#p44\">Luke 22:44</a>.</p>","referenceUris":[{"type":"scripture-ref","href":"/study/scriptures/nt/luke/22?lang=eng&amp;id=p44#p44","text":"Luke 22:44"}]},"note2":{"id":"note2","marker":"2.","pid":"173868662","context":"","text":"<p data-aid=\"173868829\" id=\"p_f0fhL\">Dallin H. Oaks, “<a class=\"cross-ref\" href=\"/study/general-conference/2021/04/35oaks?lang=eng&amp;id=p32#p32\">What Has Our Savior Done for Us?</a>” <cite>Liahona</cite>, May 2021, 77.</p>","referenceUris":[{"type":"cross-ref","href":"/study/general-conference/2021/04/35oaks?lang=eng&amp;id=p32#p32","text":"What Has Our Savior Done for Us?"}]},"note3":{"id":"note3","marker":"3.","pid":"173868670","context":"","text":"<p data-aid=\"173868832\" id=\"p_yETOD\"><a class=\"scripture-ref\" href=\"/study/scriptures/bofm/moro/10?lang=eng&amp;id=p32#p32\">Moroni 10:32</a>.</p>","referenceUris":[{"type":"scripture-ref","href":"/study/scriptures/bofm/moro/10?lang=eng&amp;id=p32#p32","text":"Moroni 10:32"}]},"note4":{"id":"note4","marker":"4.","pid":"173868706","context":"","text":"<p data-aid=\"173868835\" id=\"p_iTJ7R\">See <a class=\"scripture-ref\" href=\"/study/scriptures/ot/ezek/36?lang=eng&amp;id=p26#p26\">Ezekiel 36:26</a>.</p>","referenceUris":[{"type":"scripture-ref","href":"/study/scriptures/ot/ezek/36?lang=eng&amp;id=p26#p26","text":"Ezekiel 36:26"}]},"note5":{"id":"note5","marker":"5.","pid":"173868725","context":"","text":"<p data-aid=\"173868838\" id=\"p_aGsBb\">Russell M. Nelson, “<a class=\"cross-ref\" href=\"/study/general-conference/1995/10/perfection-pending?lang=eng&amp;id=p40#p40\">Perfection Pending</a>,” <cite>Ensign</cite>, Nov. 1995, 88.</p>","referenceUris":[{"type":"cross-ref","href":"/study/general-conference/1995/10/perfection-pending?lang=eng&amp;id=p40#p40","text":"Perfection Pending"}]},"note6":{"id":"note6","marker":"6.","pid":"173868806","context":"","text":"<p data-aid=\"173868843\" id=\"p_a7F1G\"><a class=\"scripture-ref\" href=\"/study/scriptures/bofm/moro/10?lang=eng&amp;id=p33#p33\">Moroni 10:33</a>.</p>","referenceUris":[{"type":"scripture-ref","href":"/study/scriptures/bofm/moro/10?lang=eng&amp;id=p33#p33","text":"Moroni 10:33"}]},"note7":{"id":"note7","marker":"7.","pid":"173868814","context":"","text":"<p data-aid=\"173868847\" id=\"p_eibtt\"><a class=\"scripture-ref\" href=\"/study/scriptures/nt/john/15?lang=eng&amp;id=p11#p11\">John 15:11</a>.</p>","referenceUris":[{"type":"scripture-ref","href":"/study/scriptures/nt/john/15?lang=eng&amp;id=p11#p11","text":"John 15:11"}]},"note8":{"id":"note8","marker":"8.","pid":"173868820","context":"","text":"<p data-aid=\"173868848\" id=\"p_zEiqz\"><a class=\"scripture-ref\" href=\"/study/scriptures/nt/matt/16?lang=eng&amp;id=p25#p25\">Matthew 16:25</a>.</p>","referenceUris":[{"type":"scripture-ref","href":"/study/scriptures/nt/matt/16?lang=eng&amp;id=p25#p25","text":"Matthew 16:25"}]}}},"pids":[["173868609",{"key":"173868609"}],["173868614",{"key":"173868614"}],["173868619",{"key":"173868619"}],["173868624",{"key":"173868624"}],["173868629",{"key":"173868629"}],["173868637",{"key":"173868637"}],["173868644",{"key":"173868644"}],["173868652",{"key":"173868652"}],["173868662",{"key":"173868662"}],["173868670",{"key":"173868670"}],["173868682",{"key":"173868682"}],["173868690",{"key":"173868690"}],["173868698",{"key":"173868698"}],["173868706",{"key":"173868706"}],["173868714",{"key":"173868714"}],["173868725",{"key":"173868725"}],["173868732",{"key":"173868732"}],["173868740",{"key":"173868740"}],["173868745",{"key":"173868745"}],["173868750",{"key":"173868750"}],["173868755",{"key":"173868755"}],["173868760",{"key":"173868760"}],["173868767",{"key":"173868767"}],["173868773",{"key":"173868773"}],["173868779",{"key":"173868779"}],["173868784",{"key":"173868784"}],["173868790",{"key":"173868790"}],["173868796",{"key":"173868796"}],["173868801",{"key":"173868801"}],["173868806",{"key":"173868806"}],["173868811",{"key":"173868811"}],["173868814",{"key":"173868814"}],["173868817",{"key":"173868817"}],["173868820",{"key":"173868820"}],["173868823",{"key":"173868823"}],["173868826",{"key":"173868826"}],["173868829",{"key":"173868829"}],["173868832",{"key":"173868832"}],["173868835",{"key":"173868835"}],["173868838",{"key":"173868838"}],["173868843",{"key":"173868843"}],["173868847",{"key":"173868847"}],["173868848",{"key":"173868848"}]],"tableOfContentsUri":"/general-conference/2026/10","uri":"/general-conference/2026/10/45dube","verified":true,"restricted":0}